# Dependencies
node_modules/
.pnpm-store/

# Production & Build outputs
dist/
storybook-static/
coverage/

# IDE & OS
.DS_Store
Thumbs.db
*.local
.vscode/
.idea/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Storybook
.storybook-cache/
debug-storybook.log

#env
.env
.env.local

# yalc
.yalc/
yalc.lock

# 視覺回歸測試：只提交基準圖，失敗截圖與差異圖不納入版控
screenshots/*/failed/
# 更新基準圖時產生的 before / after / diff 審查用圖片（scripts/visual-baseline-diff.mjs）
screenshots/*/changes/

# 發布用 tarball（pnpm release:pack 產出，由 GitHub Release 交付，不納入版控）
release/

# 冒煙測試專案（scripts/smoke-test.mjs 會複製到暫存目錄執行；手動在此安裝時不納入版控）
smoke/*/node_modules/
smoke/*/dist/

# Vitest browser mode 失敗時的截圖
__screenshots__/

# Custom Elements Manifest（pnpm analyze 產生，供 Storybook Docs 頁使用）
custom-elements.json
