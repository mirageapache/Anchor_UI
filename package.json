{
  "name": "@anchor-ui/core",
  "version": "1.1.0-beta.1",
  "description": "Anchor UI - framework-agnostic Web Component library with modern Slate-Navy aesthetic",
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "types": "./dist/index.d.ts",
  "style": "./dist/styles.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./accordion": {
      "types": "./dist/components/accordion/index.d.ts",
      "import": "./dist/components/accordion/index.js",
      "default": "./dist/components/accordion/index.js"
    },
    "./alert": {
      "types": "./dist/components/alert/index.d.ts",
      "import": "./dist/components/alert/index.js",
      "default": "./dist/components/alert/index.js"
    },
    "./breadcrumb": {
      "types": "./dist/components/breadcrumb/index.d.ts",
      "import": "./dist/components/breadcrumb/index.js",
      "default": "./dist/components/breadcrumb/index.js"
    },
    "./button": {
      "types": "./dist/components/button/index.d.ts",
      "import": "./dist/components/button/index.js",
      "default": "./dist/components/button/index.js"
    },
    "./card": {
      "types": "./dist/components/card/index.d.ts",
      "import": "./dist/components/card/index.js",
      "default": "./dist/components/card/index.js"
    },
    "./code-view": {
      "types": "./dist/components/code-view/index.d.ts",
      "import": "./dist/components/code-view/index.js",
      "default": "./dist/components/code-view/index.js"
    },
    "./drawer": {
      "types": "./dist/components/drawer/index.d.ts",
      "import": "./dist/components/drawer/index.js",
      "default": "./dist/components/drawer/index.js"
    },
    "./dropzone": {
      "types": "./dist/components/dropzone/index.d.ts",
      "import": "./dist/components/dropzone/index.js",
      "default": "./dist/components/dropzone/index.js"
    },
    "./favorite-btn": {
      "types": "./dist/components/favorite-btn/index.d.ts",
      "import": "./dist/components/favorite-btn/index.js",
      "default": "./dist/components/favorite-btn/index.js"
    },
    "./field": {
      "types": "./dist/components/field/index.d.ts",
      "import": "./dist/components/field/index.js",
      "default": "./dist/components/field/index.js"
    },
    "./footer": {
      "types": "./dist/components/footer/index.d.ts",
      "import": "./dist/components/footer/index.js",
      "default": "./dist/components/footer/index.js"
    },
    "./header": {
      "types": "./dist/components/header/index.d.ts",
      "import": "./dist/components/header/index.js",
      "default": "./dist/components/header/index.js"
    },
    "./icon-button": {
      "types": "./dist/components/icon-button/index.d.ts",
      "import": "./dist/components/icon-button/index.js",
      "default": "./dist/components/icon-button/index.js"
    },
    "./input": {
      "types": "./dist/components/input/index.d.ts",
      "import": "./dist/components/input/index.js",
      "default": "./dist/components/input/index.js"
    },
    "./kbd": {
      "types": "./dist/components/kbd/index.d.ts",
      "import": "./dist/components/kbd/index.js",
      "default": "./dist/components/kbd/index.js"
    },
    "./menu": {
      "types": "./dist/components/menu/index.d.ts",
      "import": "./dist/components/menu/index.js",
      "default": "./dist/components/menu/index.js"
    },
    "./modal": {
      "types": "./dist/components/modal/index.d.ts",
      "import": "./dist/components/modal/index.js",
      "default": "./dist/components/modal/index.js"
    },
    "./navbar": {
      "types": "./dist/components/navbar/index.d.ts",
      "import": "./dist/components/navbar/index.js",
      "default": "./dist/components/navbar/index.js"
    },
    "./output": {
      "types": "./dist/components/output/index.d.ts",
      "import": "./dist/components/output/index.js",
      "default": "./dist/components/output/index.js"
    },
    "./popover": {
      "types": "./dist/components/popover/index.d.ts",
      "import": "./dist/components/popover/index.js",
      "default": "./dist/components/popover/index.js"
    },
    "./segmented": {
      "types": "./dist/components/segmented/index.d.ts",
      "import": "./dist/components/segmented/index.js",
      "default": "./dist/components/segmented/index.js"
    },
    "./tag": {
      "types": "./dist/components/tag/index.d.ts",
      "import": "./dist/components/tag/index.js",
      "default": "./dist/components/tag/index.js"
    },
    "./toast": {
      "types": "./dist/components/toast/index.d.ts",
      "import": "./dist/components/toast/index.js",
      "default": "./dist/components/toast/index.js"
    },
    "./tooltip": {
      "types": "./dist/components/tooltip/index.d.ts",
      "import": "./dist/components/tooltip/index.js",
      "default": "./dist/components/tooltip/index.js"
    },
    "./vue": {
      "types": "./dist/frameworks/vue.d.ts"
    },
    "./react": {
      "types": "./dist/frameworks/react.d.ts"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./tokens": "./src/tokens/index.scss",
    "./reset": "./src/base/_reset.scss",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "./dist/index.js",
    "./dist/components/accordion/index.js",
    "./dist/components/accordion/accordion.js",
    "./dist/components/alert/index.js",
    "./dist/components/alert/alert.js",
    "./dist/components/breadcrumb/index.js",
    "./dist/components/breadcrumb/breadcrumb.js",
    "./dist/components/button/index.js",
    "./dist/components/button/button.js",
    "./dist/components/card/index.js",
    "./dist/components/card/card.js",
    "./dist/components/code-view/index.js",
    "./dist/components/code-view/code-view.js",
    "./dist/components/drawer/index.js",
    "./dist/components/drawer/drawer.js",
    "./dist/components/dropzone/index.js",
    "./dist/components/dropzone/dropzone.js",
    "./dist/components/favorite-btn/index.js",
    "./dist/components/favorite-btn/favorite-btn.js",
    "./dist/components/field/index.js",
    "./dist/components/field/field.js",
    "./dist/components/footer/index.js",
    "./dist/components/footer/footer.js",
    "./dist/components/header/index.js",
    "./dist/components/header/header.js",
    "./dist/components/icon-button/index.js",
    "./dist/components/icon-button/icon-button.js",
    "./dist/components/input/index.js",
    "./dist/components/input/input.js",
    "./dist/components/kbd/index.js",
    "./dist/components/kbd/kbd.js",
    "./dist/components/menu/index.js",
    "./dist/components/menu/menu.js",
    "./dist/components/modal/index.js",
    "./dist/components/modal/modal.js",
    "./dist/components/navbar/index.js",
    "./dist/components/navbar/navbar.js",
    "./dist/components/output/index.js",
    "./dist/components/output/output.js",
    "./dist/components/popover/index.js",
    "./dist/components/popover/popover.js",
    "./dist/components/segmented/index.js",
    "./dist/components/segmented/segmented.js",
    "./dist/components/tag/index.js",
    "./dist/components/tag/tag.js",
    "./dist/components/toast/index.js",
    "./dist/components/toast/toast.js",
    "./dist/components/tooltip/index.js",
    "./dist/components/tooltip/tooltip.js",
    "./src/**/*.ts"
  ],
  "files": [
    "dist",
    "src/tokens",
    "src/base"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && pnpm build:tokens && pnpm build:framework-types",
    "build:tokens": "sass src/tokens/index.scss dist/tokens.css --style=compressed --no-source-map",
    "build:framework-types": "pnpm analyze && node scripts/generate-framework-types.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:ssr": "node scripts/verify-ssr-import.mjs",
    "sync:package": "node scripts/sync-package-entries.mjs",
    "size": "size-limit",
    "release:verify": "node scripts/verify-release.mjs",
    "check:versions": "node scripts/check-tool-versions.mjs",
    "audit:runtime": "node scripts/audit-runtime.mjs",
    "release:pack": "pnpm build && pnpm verify:package && pnpm size && pnpm release:verify && node scripts/pack.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "wtr",
    "test:watch": "wtr --watch",
    "test:coverage": "wtr --coverage",
    "test:a11y": "wtr \"src/components/**/*.a11y.test.ts\"",
    "test:visual": "wtr --config web-test-runner.visual.config.mjs",
    "test:visual:update": "wtr --config web-test-runner.visual.config.mjs --update-visual-baseline",
    "test:visual:docker": "node scripts/visual-docker.mjs",
    "test:visual:docker:update": "node scripts/visual-docker.mjs --update",
    "test:vue": "pnpm --filter example-vue3 test",
    "test:angular": "pnpm --filter example-angular test",
    "test:react": "pnpm --filter example-react test",
    "build:examples": "pnpm --filter example-vue3 --filter example-angular --filter example-react build && node scripts/verify-example-builds.mjs",
    "typecheck:examples": "pnpm --filter example-vue3 --filter example-angular --filter example-react typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "stylelint": "stylelint \"src/**/*.{css,scss}\"",
    "stylelint:fix": "stylelint \"src/**/*.{css,scss}\" --fix",
    "format:check": "prettier --check \"src/**/*.{ts,js,scss,css,json,md}\"",
    "format": "prettier --write \"src/**/*.{ts,js,scss,css,json,md}\"",
    "prepare": "husky",
    "storybook": "pnpm analyze && storybook dev -p 6006",
    "build-storybook": "pnpm analyze && storybook build",
    "test:storybook": "pnpm analyze && vitest run --project=storybook",
    "yalc:publish": "pnpm build && yalc publish --no-scripts",
    "yalc:push": "pnpm build && yalc push --no-scripts",
    "dev:yalc": "node scripts/yalc-watch.mjs",
    "analyze": "cem analyze"
  },
  "keywords": [
    "anchor-ui",
    "web-components",
    "lit",
    "design-system",
    "design-tokens"
  ],
  "author": "mirageapache",
  "license": "MIT",
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "lit": "^3.3.3"
  },
  "peerDependencies": {
    "@types/react": ">=18.0.0",
    "vue": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@custom-elements-manifest/analyzer": "0.11.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@open-wc/testing": "^5.0.0",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@storybook/addon-docs": "10.6.8",
    "@storybook/addon-vitest": "10.6.8",
    "@storybook/web-components-vite": "10.6.8",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@vitest/browser": "5.1.1",
    "@vitest/browser-playwright": "5.1.1",
    "@web/dev-server-esbuild": "^2.0.1",
    "@web/test-runner": "^1.0.1",
    "@web/test-runner-commands": "^1.1.0",
    "@web/test-runner-playwright": "^1.0.2",
    "@web/test-runner-visual-regression": "^1.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-lit": "^2.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "pixelmatch": "8.0.0",
    "playwright": "1.63.0",
    "pngjs": "7.0.0",
    "prettier": "^3.10.1",
    "sass": "^1.108.2",
    "size-limit": "^14.3.0",
    "storybook": "10.6.8",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "5.1.1",
    "vue": "^3.5.45",
    "yalc": "1.0.0-pre.53"
  }
}
